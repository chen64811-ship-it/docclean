# DocClean Backend Configuration
# Copy this file to .env and fill in your values

# App server
HOST=0.0.0.0
PORT=5000

# License secret (REQUIRED)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
DOCLEAN_LICENSE_SECRET=change-me-to-a-random-64-char-hex-string

# Authentication (optional but recommended for production)
# When set, enables HTTP Basic Auth for the web UI and API
DOCLEAN_USERNAME=admin
DOCLEAN_PASSWORD=change-me-to-a-secure-password

# Lemon Squeezy webhook (optional, for license automation)
# Get this from Lemon Squeezy dashboard → Settings → Webhooks
LEMON_SQUEEZY_SECRET=

# LLM / AI (optional, for RAG Q&A feature)
# Supports OpenAI-compatible APIs (MiniMax, OpenAI, etc.)
LLM_API_KEY=
LLM_API_BASE=https://api.minimax.chat/v1
LLM_MODEL=abab7-chat
