# ============================================================
# DocClean Configuration
# Copy this file to backend/.env and edit the values
#   cp .env.example backend/.env
# ============================================================

# ── File Storage ──
UPLOAD_FOLDER=uploads
OUTPUT_FOLDER=outputs
MAX_CONTENT_LENGTH=52428800
ALLOWED_EXTENSIONS=pdf,docx,xlsx,png,jpg,jpeg,gif,bmp,webp,jfif,md

# ── Server ──
HOST=0.0.0.0
PORT=5000

# ── Authentication (optional — leave empty for open access) ──
DOCLEAN_USERNAME=
DOCLEAN_PASSWORD=

# ── License Keys (required for commercial features) ──
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
DOCLEAN_LICENSE_SECRET=

# ── OCR ──
OCR_USE_GPU=true
OCR_LANG=en
# Optional: custom CUDA DLL search paths (semicolon-separated, Windows only)
# OCR_DLL_PATHS=

# ── LLM API (optional — AI Q&A and classification) ──
# OpenRouter / OpenAI / MiniMax / Ollama compatible
LLM_API_KEY=
LLM_API_BASE=https://api.minimax.chat/v1
LLM_MODEL=MiniMax-M2.7
