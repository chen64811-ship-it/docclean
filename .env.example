# ============================================================
# DocClean 配置文件
# 复制此文件为 .env 并修改里面的值
#   复制命令：cp .env.example backend/.env
# ============================================================

# 上传文件存放目录（相对于项目根目录）
UPLOAD_FOLDER=uploads

# 导出 Markdown 文件存放目录
OUTPUT_FOLDER=outputs

# 允许的最大文件大小（单位：字节），默认 50MB
MAX_CONTENT_LENGTH=52428800

# 支持的文件格式（逗号分隔）
ALLOWED_EXTENSIONS=pdf,docx,xlsx,png,jpg,jpeg,gif,bmp,webp,jfif,md

# 服务器监听地址
HOST=0.0.0.0

# 服务器端口
PORT=5000

# PaddleOCR 是否使用 GPU（CPU 版 Docker 请设为 false）
OCR_USE_GPU=true

# OCR 语言模型
#   en   — English model (default, best for Latin-based documents)
#   ch   — Chinese model (best for Chinese documents)
#   auto — Auto-detect from document text (PDF only, images use 'en' as fallback)
OCR_LANG=en

# LLM API 配置（可选，不配也能用基础功能）
# 支持 OpenAI 兼容接口（MiniMax、OpenAI、Ollama 等）
LLM_API_KEY=your-api-key-here
LLM_API_BASE=https://api.minimax.chat/v1
LLM_MODEL=MiniMax-M2.7
